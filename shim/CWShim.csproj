<Project Sdk="Microsoft.NET.Sdk">
  <!-- Small runtime library the patched game assemblies call into instead of UnityEngine.Input, Cursor,
       PlayerPrefs, Microphone, Process, Screen.SetResolution, ... The iOS mod (mod/, CWIOS.dll) drives it.
       It must not reference any game assembly (the game assemblies reference it). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>CWShim</AssemblyName>
    <RootNamespace>CWShim</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ManagedDir Condition="'$(ManagedDir)' == ''">C:\Users\v0id\cw-original\Content Warning_Data\Managed</ManagedDir>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(ManagedDir)\UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
